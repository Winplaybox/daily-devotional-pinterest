# Gemini API Key (from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Pinterest App Credentials (from https://developers.pinterest.com/)
# Run `python setup_pinterest.py` to auto-fill ACCESS_TOKEN, REFRESH_TOKEN, and BOARD_ID via browser login!
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=your_pinterest_oauth_access_token_here
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=your_pinterest_board_id_here
# Set to true if using a Pinterest Sandbox app token
PINTEREST_SANDBOX=false

# Default generation settings
DEFAULT_RELIGIONS=hindu
DEFAULT_LANGUAGES=gu,hi,en
# Image generation model (gemini-nano-banana-2.1 or gemini-3-pro-image or gemini-3.1-flash-lite-image)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Optional free/freemium fallback: Hugging Face Inference API (https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
